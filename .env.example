# Copia este archivo a .env.local y completa los valores.
# Obtén tu Project ID en https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=...
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=...

# Google Analytics (se activará más adelante). Sin ID, GA nunca se carga;
# con ID, solo se carga si el visitante acepta el banner de cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=...

# Formularios (Contact + Subscribe). Cambia CONTACT_TO_EMAIL cuando pase a producción.
# API key en https://resend.com. En pruebas, registra esa misma cuenta de correo.
RESEND_API_KEY=
CONTACT_TO_EMAIL=katheryn@madeotr.com
CONTACT_FROM_EMAIL="Square2 <beth.t@resend.dev>"